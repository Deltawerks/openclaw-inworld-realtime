{
  "name": "@deltawerks/inworld-realtime",
  "version": "0.1.1",
  "description": "Inworld realtime voice for OpenClaw Talk and Voice Call.",
  "type": "module",
  "license": "MIT",
  "author": "DeltaWerks",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deltawerks/openclaw-inworld-realtime.git"
  },
  "homepage": "https://github.com/Deltawerks/openclaw-inworld-realtime#readme",
  "bugs": {
    "url": "https://github.com/Deltawerks/openclaw-inworld-realtime/issues"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
