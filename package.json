    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.7 <2026.10.8",
      "minGatewayVersion": "2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7",
      "pluginSdkVersion": "2026.10.7"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "clawhub": "0.23.3",
    "openclaw": "2026.10.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
